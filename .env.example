# Base URL of your local AI server. Works with Ollama, LM Studio, or any
# tool that exposes an OpenAI-compatible API. Ollama's default port is
# 11434; LM Studio's default port is 1234.
LOCAL_AI_BASE_URL=http://localhost:11434

# Which model to use. This should match a model you've already downloaded
# in your local AI tool (e.g. "ollama pull qwen3:4b", or a model loaded in
# LM Studio).
LOCAL_AI_MODEL=qwen3:4b

# AI mode: "demo" (no local AI needed, uses canned data) or "local" (a real
# local model via Ollama, LM Studio, or similar)
AI_MODE=demo
